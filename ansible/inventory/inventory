    ansible_user: ubuntu
    ansible_become: true
    ansible_become_method: sudo
    ansible_ssh_private_key_file: /home/ubuntu/.ssh/id_ed25519
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'

  hosts:
    master:
      ansible_host: 10.196.244.29
      ip: 10.196.244.29
      access_ip: 10.196.244.29
      etcd_member_name: etcd1

    worker-1:
      ansible_host: 10.196.241.7
      ip: 10.196.241.7
      access_ip: 10.196.241.7

    worker-2:
      ansible_host: 10.196.244.206
      ip: 10.196.244.206
      access_ip: 10.196.244.206

    worker-3:
      ansible_host: 10.196.244.65
      ip: 10.196.244.65
      access_ip: 10.196.244.65

  children:
    kube_control_plane:
      hosts:
        master:

    kube_node:
      hosts:
        worker-1:
        worker-2:
        worker-3:

    etcd:
      hosts:
        master:

    k8s_cluster:
      children:
        kube_control_plane:
        kube_node: