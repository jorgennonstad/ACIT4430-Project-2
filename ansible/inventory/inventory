    ansible_ssh_private_key_file: /home/ubuntu/.ssh/id_ed25519
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'

  hosts:
    master:
      ansible_host: 10.196.245.21
      ip: 10.196.245.21
      access_ip: 10.196.245.21
      etcd_member_name: etcd1

    worker-1:
      ansible_host: 10.196.242.255
      ip: 10.196.242.255
      access_ip: 10.196.242.255

    worker-2:
      ansible_host: 10.196.241.122
      ip: 10.196.241.122
      access_ip: 10.196.241.122

    worker-3:
      ansible_host: 10.196.241.124
      ip: 10.196.241.124
      access_ip: 10.196.241.124

  children:
    kube_control_plane:
      hosts:
        master:

    kube_node:
      hosts:
        worker-1:
        worker-2:
        worker-3:

    etcd:
      hosts:
        master:

    k8s_cluster:
