          "schema_version": 0,
          "attributes": {
            "content": "all:\n  vars:\n    ansible_user: ubuntu\n    ansible_become: true\n    ansible_become_method: sudo\n    ansible_ssh_private_key_file: /home/ubuntu/.ssh/id_ed25519\n    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'\n\n  hosts:\n    master:\n      ansible_host: 10.196.245.21\n      ip: 10.196.245.21\n      access_ip: 10.196.245.21\n      etcd_member_name: etcd1\n\n    worker-1:\n      ansible_host: 10.196.242.255\n      ip: 10.196.242.255\n      access_ip: 10.196.242.255\n\n    worker-2:\n      ansible_host: 10.196.241.122\n      ip: 10.196.241.122\n      access_ip: 10.196.241.122\n\n    worker-3:\n      ansible_host: 10.196.241.124\n      ip: 10.196.241.124\n      access_ip: 10.196.241.124\n\n  children:\n    kube_control_plane:\n      hosts:\n        master:\n\n    kube_node:\n      hosts:\n        worker-1:\n        worker-2:\n        worker-3:\n\n    etcd:\n      hosts:\n        master:\n\n    k8s_cluster:\n      children:\n        kube_control_plane:\n        kube_node:",
