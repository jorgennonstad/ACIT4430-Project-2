          "attributes": {
            "content": "all:\n  vars:\n    ansible_user: ubuntu\n    ansible_become: true\n    ansible_become_method: sudo\n    ansible_ssh_private_key_file: /home/ubuntu/.ssh/id_ed25519\n    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'\n  hosts:\n    master:\n      ansible_host: 10.196.243.162\n      ip: 10.196.243.162\n      access_ip: 10.196.243.162\n\n    worker-1:\n      ansible_host: 10.196.242.190\n\n    worker-2:\n      ansible_host: 10.196.241.57\n\n    worker-3:\n      ansible_host: 10.196.244.211\n\n  children:\n    kube_control_plane:\n      hosts:\n        master:\n\n    kube_node:\n      hosts:\n        worker-1:\n        worker-2:\n        worker-3:\n\n    etcd:\n      hosts:\n        master:\n\n    k8s_cluster:\n      children:\n        kube_control_plane:\n        kube_node:",
